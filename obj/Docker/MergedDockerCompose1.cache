name: dockercompose1210656507643278689
services:
  postgres:
    container_name: kopikala-db
    environment:
      POSTGRES_DB: kopikala
      POSTGRES_PASSWORD: kopikala
      POSTGRES_USER: kopikala
    image: postgres:17-alpine
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    restart: always
    volumes:
      - type: bind
        source: I:\dev\web\KopiKala\init.sql
        target: /docker-entrypoint-initdb.d/init.sql
        read_only: true
        bind: {}
      - type: volume
        source: pgdata
        target: /var/lib/postgresql/data
        volume: {}
networks:
  default:
    name: dockercompose1210656507643278689_default
volumes:
  pgdata:
    name: dockercompose1210656507643278689_pgdata