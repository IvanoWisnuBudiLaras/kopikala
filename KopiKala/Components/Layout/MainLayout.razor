@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="@KopiKalaTheme.CreateTheme()" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="kopi-layout">
    @* ── Top App Bar with Dynamic Navbar ── *@
    <MudAppBar Elevation="2" Class="kopi-appbar px-4" Color="Color.Inherit">
        @* Hamburger Button for Mobile / Sidebar Navigation *@
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle"
                       Class="mr-2"
                       aria-label="Toggle navigation menu" />

        @* Brand Logo *@
        <MudIconButton Icon="@Icons.Material.Filled.Coffee" Color="Color.Primary" Class="mr-1" Href="/" />
        <MudLink Href="/" Underline="Underline.None">
            <MudText Typo="Typo.h6" Class="font-weight-bold mr-4" Color="Color.Primary">
                KopiKala
            </MudText>
        </MudLink>

        <MudSpacer />

        @* ── DYNAMIC NAVBAR: Role-Based via AuthorizeView ── *@
        <AuthorizeView>
            <Authorized>
                @* Customer Shortcuts *@
                <AuthorizeView Policy="CustomerOnly" Context="custContext">
                    <Authorized>
                        <MudButton Href="/Booking"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="mr-2 kopi-nav-btn"
                                   StartIcon="@Icons.Material.Filled.EventSeat">
                            Pesan Meja
                        </MudButton>
                        <MudButton Href="/Customer/Orders"
                                   Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   Size="Size.Small"
                                   Class="mr-2 kopi-nav-btn"
                                   StartIcon="@Icons.Material.Filled.ReceiptLong">
                            Pesanan Saya
                        </MudButton>
                    </Authorized>
                </AuthorizeView>

                @* Staff Shortcuts with Direct Sub-Menu Navigation (Kasir / Barista / Manager) *@
                <AuthorizeView Policy="StaffAccess" Context="staffContext">
                    <Authorized>
                        <MudMenu Label="Portal Staf"
                                 StartIcon="@Icons.Material.Filled.Badge"
                                 EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                 Variant="Variant.Outlined"
                                 Color="Color.Warning"
                                 Size="Size.Small"
                                 Class="mr-2 kopi-nav-btn"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopLeft">
                            <MudMenuItem Href="/Staff" Icon="@Icons.Material.Filled.Dashboard">
                                Ringkasan Portal Staf
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Href="/Staff?tab=0" Icon="@Icons.Material.Filled.TableBar">
                                Denah Meja &amp; Status
                            </MudMenuItem>
                            <MudMenuItem Href="/Staff?tab=1" Icon="@Icons.Material.Filled.FactCheck">
                                Verifikasi Transfer
                            </MudMenuItem>
                            <MudMenuItem Href="/Staff?tab=2" Icon="@Icons.Material.Filled.Search">
                                Cari Transaksi / Tamu
                            </MudMenuItem>
                        </MudMenu>
                    </Authorized>
                </AuthorizeView>

                @* SuperAdmin Shortcuts with Direct Sub-Menu Navigation *@
                <AuthorizeView Policy="SuperAdminOnly" Context="adminContext">
                    <Authorized>
                        <MudMenu Label="SuperAdmin"
                                 StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                                 EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                 Variant="Variant.Outlined"
                                 Color="Color.Error"
                                 Size="Size.Small"
                                 Class="mr-2 kopi-nav-btn"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopLeft">
                            <MudMenuItem Href="/SuperAdmin" Icon="@Icons.Material.Filled.Dashboard">
                                Panel Utama
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Href="/SuperAdmin?tab=0" Icon="@Icons.Material.Filled.Insights">
                                Analitik &amp; KPI Bisnis
                            </MudMenuItem>
                            <MudMenuItem Href="/SuperAdmin?tab=1" Icon="@Icons.Material.Filled.PeopleAlt">
                                Akun Staf &amp; Dynamic PBAC
                            </MudMenuItem>
                            <MudMenuItem Href="/SuperAdmin?tab=2" Icon="@Icons.Material.Filled.Storage">
                                Master Data Kafe
                            </MudMenuItem>
                        </MudMenu>
                    </Authorized>
                </AuthorizeView>

                @* Theme Toggle *@
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="ToggleDarkMode"
                               Class="mr-2" />

                @* User Profile Dropdown *@
                <MudMenu Label="@context.User.Identity?.Name"
                         EndIcon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Inherit"
                         Class="mr-1">
                    <MudMenuItem Href="/Account/Manage" Icon="@Icons.Material.Filled.Person">
                        Profil Akun
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="HandleLogout">
                        Keluar
                    </MudMenuItem>
                </MudMenu>
            </Authorized>

            <NotAuthorized>
                @* Public / Guest Navigation *@
                <MudButton Href="/"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           Class="mr-2 kopi-nav-btn">
                    Beranda
                </MudButton>

                @* Theme Toggle *@
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="ToggleDarkMode"
                               Class="mr-2" />

                <MudButton Href="/Account/Login"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           Class="mr-2 kopi-nav-btn">
                    Masuk
                </MudButton>
                <MudButton Href="/Account/Register"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="kopi-nav-btn">
                    Daftar
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* ── Mobile Navigation Drawer ── *@
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="3" Variant="DrawerVariant.Temporary">
        <MudDrawerHeader Class="px-4 py-3 d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Coffee" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">KopiKala</MudText>
        </MudDrawerHeader>
        <MudDivider />
        <MudNavMenu Class="pa-2">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Beranda
            </MudNavLink>

            <AuthorizeView>
                <Authorized>
                    <AuthorizeView Policy="CustomerOnly" Context="drawerCustContext">
                        <Authorized>
                            <MudNavGroup Title="Menu Pelanggan" Icon="@Icons.Material.Filled.Restaurant" Expanded="true">
                                <MudNavLink Href="/Booking" Icon="@Icons.Material.Filled.EventSeat">
                                    Pesan Meja
                                </MudNavLink>
                                <MudNavLink Href="/Customer/Orders" Icon="@Icons.Material.Filled.ReceiptLong">
                                    Pesanan Saya
                                </MudNavLink>
                            </MudNavGroup>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Policy="StaffAccess" Context="drawerStaffContext">
                        <Authorized>
                            <MudNavGroup Title="Portal Staf" Icon="@Icons.Material.Filled.Badge" Expanded="true">
                                <MudNavLink Href="/Staff" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                                    Ringkasan Staf
                                </MudNavLink>
                                <MudNavLink Href="/Staff?tab=0" Icon="@Icons.Material.Filled.TableBar">
                                    Denah Meja &amp; Status
                                </MudNavLink>
                                <MudNavLink Href="/Staff?tab=1" Icon="@Icons.Material.Filled.FactCheck">
                                    Verifikasi Transfer
                                </MudNavLink>
                                <MudNavLink Href="/Staff?tab=2" Icon="@Icons.Material.Filled.Search">
                                    Cari Transaksi / Tamu
                                </MudNavLink>
                            </MudNavGroup>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Policy="SuperAdminOnly" Context="drawerAdminContext">
                        <Authorized>
                            <MudNavGroup Title="SuperAdmin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                                <MudNavLink Href="/SuperAdmin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                                    Panel Utama
                                </MudNavLink>
                                <MudNavLink Href="/SuperAdmin?tab=0" Icon="@Icons.Material.Filled.Insights">
                                    Analitik &amp; KPI Bisnis
                                </MudNavLink>
                                <MudNavLink Href="/SuperAdmin?tab=1" Icon="@Icons.Material.Filled.PeopleAlt">
                                    Akun Staf &amp; PBAC
                                </MudNavLink>
                                <MudNavLink Href="/SuperAdmin?tab=2" Icon="@Icons.Material.Filled.Storage">
                                    Master Data Kafe
                                </MudNavLink>
                            </MudNavGroup>
                        </Authorized>
                    </AuthorizeView>

                    <MudDivider Class="my-2" />
                    <MudNavLink Href="/Account/Manage" Icon="@Icons.Material.Filled.Person">
                        Profil Akun (@context.User.Identity?.Name)
                    </MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="HandleLogout">
                        Keluar (Logout)
                    </MudNavLink>
                </Authorized>
                <NotAuthorized>
                    <MudDivider Class="my-2" />
                    <MudNavLink Href="/Account/Login" Icon="@Icons.Material.Filled.Login">
                        Masuk
                    </MudNavLink>
                    <MudNavLink Href="/Account/Register" Icon="@Icons.Material.Filled.PersonAdd">
                        Daftar
                    </MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    @* ── Main Content ── *@
    <MudMainContent Class="kopi-main">
        @Body
    </MudMainContent>

    @* ── Footer ── *@
    <MudPaper Elevation="2" Class="kopi-footer" Square="true">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
            <MudGrid Spacing="4" Justify="Justify.SpaceBetween">
                <MudItem xs="12" sm="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.Coffee" Size="Size.Small" Class="mr-1" /> KopiKala
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Nikmati kopi terbaik tanpa antre meja. Reservasi &amp; pre-order mudah, cepat, dan elegan.
                        </MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Jelajahi</MudText>
                        <MudLink Href="/" Color="Color.Primary" Typo="Typo.body2">Beranda</MudLink>
                        <MudLink Href="/Account/Login" Color="Color.Primary" Typo="Typo.body2">Masuk</MudLink>
                        <MudLink Href="/Account/Register" Color="Color.Primary" Typo="Typo.body2">Daftar</MudLink>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Kontak</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" /> Jl. Kopi Nusantara No. 42
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-1" /> (021) 555-0142
                        </MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                &copy; 2025 KopiKala &mdash; Semua hak dilindungi.
            </MudText>
        </MudContainer>
    </MudPaper>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen;
    private bool _isDarkMode;
    private string? _currentUrl;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private void HandleLogout()
    {
        NavigationManager.NavigateTo("/auth/logout", forceLoad: true);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
