@page "/Booking"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IBookingService BookingService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Pesan Meja & Pre-Order F&B - KopiKala</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudText Typo="Typo.h4" Class="font-weight-bold mb-2" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.EventSeat" Class="mr-2" Size="Size.Large" />
        Pemesanan Meja & Pre-Order F&B
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Pilih sesi waktu, tentukan meja favorit Anda, dan pesan menu pilihan tanpa perlu mengantre.
    </MudText>

    @if (_isLoading)
    {
        <MudCard Class="pa-8 text-center" Elevation="2">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Memuat data ketersediaan meja dan menu...</MudText>
        </MudCard>
    }
    else
    {
        @* ── STAGES / WIZARD STEPPER ── *@
        <MudPaper Class="pa-6 mb-6" Elevation="2">
            <MudGrid Spacing="3">
                @* Step Navigation Header *@
                <MudItem xs="12">
                    <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" OverrideStyles="false" Class="d-flex flex-wrap justify-center mb-6">
                        <MudButton Variant="@(_activeStep == 1 ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   OnClick="@(() => GoToStep(1))"
                                   StartIcon="@Icons.Material.Filled.CalendarMonth">
                            1. Jadwal & Durasi
                        </MudButton>
                        <MudButton Variant="@(_activeStep == 2 ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   OnClick="@(() => GoToStep(2))"
                                   StartIcon="@Icons.Material.Filled.TableBar">
                            2. Denah Meja
                        </MudButton>
                        <MudButton Variant="@(_activeStep == 3 ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   OnClick="@(() => GoToStep(3))"
                                   StartIcon="@Icons.Material.Filled.RestaurantMenu">
                            3. Pre-Order F&B
                        </MudButton>
                        <MudButton Variant="@(_activeStep == 4 ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   OnClick="@(() => GoToStep(4))"
                                   StartIcon="@Icons.Material.Filled.CheckCircle">
                            4. Konfirmasi
                        </MudButton>
                    </MudButtonGroup>
                </MudItem>

                @* ── STEP 1: JADWAL & DURASI ── *@
                @if (_activeStep == 1)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-4" Color="Color.Primary">
                            Langkah 1: Tentukan Tanggal, Sesi & Durasi Duduk
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudDatePicker Label="Tanggal Reservasi"
                                       @bind-Date="_selectedDate"
                                       MinDate="@DateTime.Today"
                                       MaxDate="@DateTime.Today.AddDays(14)"
                                       DateFormat="dddd, dd MMMM yyyy"
                                       PickerVariant="PickerVariant.Dialog"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       AdornmentColor="Color.Primary" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudSelect T="int" Label="Sesi Waktu Kafe"
                                   Value="@_selectedTimeslotId"
                                   ValueChanged="OnTimeslotChanged"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var slot in _timeslots)
                            {
                                <MudSelectItem Value="@slot.Id">
                                    @slot.SessionName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-bold">
                            Durasi Duduk (Jam)
                        </MudText>
                        <MudChipSet T="int" SelectedValue="@_durationHours" SelectedValueChanged="OnDurationChanged" CheckMark="true">
                            <MudChip Value="1" Color="Color.Primary" Variant="Variant.Filled">1 Jam</MudChip>
                            <MudChip Value="2" Color="Color.Primary" Variant="Variant.Filled">2 Jam (Rekomendasi)</MudChip>
                            <MudChip Value="3" Color="Color.Primary" Variant="Variant.Filled">3 Jam</MudChip>
                        </MudChipSet>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => GoToStep(2))">
                            Lanjut: Pilih Meja
                        </MudButton>
                    </MudItem>
                }

                @* ── STEP 2: DENAH MEJA 2D ── *@
                @if (_activeStep == 2)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-1" Color="Color.Primary">
                            Langkah 2: Pilih Denah Meja Interaktif
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Tanggal: <b>@(_selectedDate?.ToString("dd MMM yyyy") ?? "-")</b> | Sesi: <b>@(_selectedTimeslot?.SessionName ?? "-")</b>
                        </MudText>

                        @* Legend *@
                        <MudStack Row="true" Spacing="4" Class="mb-6 flex-wrap align-center">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Square" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Tersedia (Siap Dipilih)</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Square" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Pilihan Anda</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Square" Color="Color.Dark" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Terisi / Tidak Tersedia</MudText>
                            </MudStack>
                        </MudStack>
                    </MudItem>

                    @* Indoor AC Section *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.AcUnit" Size="Size.Small" Class="mr-1" /> Area Indoor AC
                        </MudText>
                        <MudGrid Spacing="3">
                            @foreach (var table in _tables.Where(t => t.Area.Contains("Indoor", StringComparison.OrdinalIgnoreCase)))
                            {
                                var isSelected = _selectedTable?.Id == table.Id;
                                <MudItem xs="6" sm="4" md="3">
                                    <MudCard Elevation="@(isSelected ? 6 : 2)"
                                             Outlined="@(!isSelected)"
                                             Class="@GetTableCardClass(table, isSelected)"
                                             Style="cursor: pointer; transition: all 0.2s ease-in-out;"
                                             data-testid="@($"table-{table.TableNumber}")"
                                             @onclick="@(() => SelectTable(table))">
                                        <MudCardContent Class="text-center pa-4">
                                            <MudIcon Icon="@Icons.Material.Filled.TableRestaurant"
                                                     Size="Size.Large"
                                                     Color="@GetTableIconColor(table, isSelected)" />
                                            <MudText Typo="Typo.h6" Class="font-weight-bold mt-1">
                                                @table.TableNumber
                                            </MudText>
                                            <MudChip T="string" Size="Size.Small" Color="@(isSelected ? Color.Warning : (table.IsAvailable ? Color.Success : Color.Dark))" Class="mt-1">
                                                @(isSelected ? "Dipilih" : (table.IsAvailable ? "Tersedia" : "Penuh"))
                                            </MudChip>
                                            <MudText Typo="Typo.caption" Class="d-block mt-2" Color="Color.Secondary">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />
                                                Kapasitas: @table.Capacity Orang
                                            </MudText>
                                        </MudCardContent>
                                        <MudCardActions Class="pa-3 pt-0 d-flex justify-center">
                                            <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                                       Color="@(isSelected ? Color.Warning : (table.IsAvailable ? Color.Primary : Color.Default))"
                                                       Size="Size.Small"
                                                       FullWidth="true"
                                                       Disabled="@(!table.IsAvailable)"
                                                       data-testid="@($"btn-select-{table.TableNumber}")"
                                                       OnClick="@(() => SelectTable(table))">
                                                @(isSelected ? "Meja Terpilih" : (table.IsAvailable ? "Pilih Meja Ini" : "Penuh"))
                                            </MudButton>
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>

                    @* Outdoor Section *@
                    <MudItem xs="12" Class="mt-4">
                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.WbSunny" Size="Size.Small" Class="mr-1" /> Area Outdoor Smoking
                        </MudText>
                        <MudGrid Spacing="3">
                            @foreach (var table in _tables.Where(t => t.Area.Contains("Outdoor", StringComparison.OrdinalIgnoreCase)))
                            {
                                var isSelected = _selectedTable?.Id == table.Id;
                                <MudItem xs="6" sm="4" md="3">
                                    <MudCard Elevation="@(isSelected ? 6 : 2)"
                                             Outlined="@(!isSelected)"
                                             Class="@GetTableCardClass(table, isSelected)"
                                             Style="cursor: pointer; transition: all 0.2s ease-in-out;"
                                             data-testid="@($"table-{table.TableNumber}")"
                                             @onclick="@(() => SelectTable(table))">
                                        <MudCardContent Class="text-center pa-4">
                                            <MudIcon Icon="@Icons.Material.Filled.Deck"
                                                     Size="Size.Large"
                                                     Color="@GetTableIconColor(table, isSelected)" />
                                            <MudText Typo="Typo.h6" Class="font-weight-bold mt-1">
                                                @table.TableNumber
                                            </MudText>
                                            <MudChip T="string" Size="Size.Small" Color="@(isSelected ? Color.Warning : (table.IsAvailable ? Color.Success : Color.Dark))" Class="mt-1">
                                                @(isSelected ? "Dipilih" : (table.IsAvailable ? "Tersedia" : "Penuh"))
                                            </MudChip>
                                            <MudText Typo="Typo.caption" Class="d-block mt-2" Color="Color.Secondary">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />
                                                Kapasitas: @table.Capacity Orang
                                            </MudText>
                                        </MudCardContent>
                                        <MudCardActions Class="pa-3 pt-0 d-flex justify-center">
                                            <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                                       Color="@(isSelected ? Color.Warning : (table.IsAvailable ? Color.Primary : Color.Default))"
                                                       Size="Size.Small"
                                                       FullWidth="true"
                                                       Disabled="@(!table.IsAvailable)"
                                                       data-testid="@($"btn-select-{table.TableNumber}")"
                                                       OnClick="@(() => SelectTable(table))">
                                                @(isSelected ? "Meja Terpilih" : (table.IsAvailable ? "Pilih Meja Ini" : "Penuh"))
                                            </MudButton>
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-space-between mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => GoToStep(1))">
                            Kembali
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(_selectedTable == null)"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => GoToStep(3))">
                            Lanjut: Pre-Order F&B
                        </MudButton>
                    </MudItem>
                }

                @* ── STEP 3: PRE-ORDER F&B ── *@
                @if (_activeStep == 3)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-1" Color="Color.Primary">
                            Langkah 3: Pre-Order Makanan & Minuman
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Pesanan Anda akan diracik segar dan siap disajikan saat rombongan tiba di kafe.
                        </MudText>

                        @* Category Filter Chips *@
                        <MudChipSet T="string" SelectedValue="@_selectedCategory" SelectedValueChanged="OnCategoryFilterChanged" Class="mb-6">
                            <MudChip Value="@("Semua")" Color="Color.Primary" Variant="Variant.Filled">Semua Menu</MudChip>
                            <MudChip Value="@("Coffee")" Color="Color.Primary" Variant="Variant.Filled">Coffee</MudChip>
                            <MudChip Value="@("Non-Coffee")" Color="Color.Primary" Variant="Variant.Filled">Non-Coffee</MudChip>
                            <MudChip Value="@("Pastry & Bakery")" Color="Color.Primary" Variant="Variant.Filled">Pastry & Bakery</MudChip>
                            <MudChip Value="@("Snacks")" Color="Color.Primary" Variant="Variant.Filled">Snacks</MudChip>
                        </MudChipSet>
                    </MudItem>

                    @* Menu Items Grid *@
                    @foreach (var item in FilteredMenuItems)
                    {
                        var qty = GetCartQuantity(item.Id);
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="2" Class="h-100 d-flex flex-column" Style="@(!item.IsAvailable ? "opacity: 0.6;" : "")">
                                <MudCardMedia Image="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/menu/menu-kopi-susu.jpg" : item.ImageUrl)" Height="160" />
                                <MudCardContent Class="flex-grow-1 pa-4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">
                                        @item.Category
                                    </MudText>
                                    <MudText Typo="Typo.h6" Class="font-weight-bold my-1">
                                        @item.Name
                                    </MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Primary" Class="font-weight-bold">
                                        @item.Price.ToRupiah()
                                    </MudText>
                                    @if (!item.IsAvailable)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="mt-2">Habis</MudChip>
                                    }
                                </MudCardContent>
                                <MudCardActions Class="pa-4 pt-0 d-flex justify-space-between align-center">
                                    @if (!item.IsAvailable)
                                    {
                                        <MudButton Disabled="true" Variant="Variant.Filled" Size="Size.Small" FullWidth="true">
                                            Menu Habis
                                        </MudButton>
                                    }
                                    else if (qty == 0)
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                                   OnClick="@(() => AddToCart(item))"
                                                   FullWidth="true">
                                            Tambah Menu
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
                                            <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                                           Size="Size.Small"
                                                           Variant="Variant.Outlined"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => DecreaseCart(item.Id))" />
                                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold px-3">
                                                @qty
                                            </MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                           Size="Size.Small"
                                                           Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => AddToCart(item))" />
                                        </MudStack>
                                    }
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }

                    <MudItem xs="12" Class="d-flex justify-space-between mt-6">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => GoToStep(2))">
                            Kembali ke Meja
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => GoToStep(4))">
                            Lanjut: Konfirmasi Pesanan
                        </MudButton>
                    </MudItem>
                }

                @* ── STEP 4: KONFIRMASI CHECKOUT ── *@
                @if (_activeStep == 4)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h5" Class="font-weight-bold mb-1" Color="Color.Primary">
                            Langkah 4: Konfirmasi Identitas & Metode Pembayaran
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
                            Pastikan data pemesan dan rincian pesanan sudah sesuai sebelum membuat invoice.
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Elevation="2" Class="pa-4 mb-4">
                            <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                Data Pemesan (Perwakilan Rombongan)
                            </MudText>
                            <MudTextField Label="Nama Perwakilan"
                                          @bind-Value="_representativeName"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Class="mb-4"
                                          HelperText="Nama ini akan dipanggil oleh kasir saat tiba di kafe" />
                            <MudTextField Label="Nomor WhatsApp"
                                          @bind-Value="_customerPhone"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Class="mb-4"
                                          HelperText="Untuk pengiriman notifikasi pengingat H-1 jam" />

                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                                Metode Pembayaran
                            </MudText>
                            <MudRadioGroup T="string" @bind-Value="_paymentMethod">
                                <MudRadio Value="@("TransferBank")" Color="Color.Primary">
                                    <b>Transfer Bank (BCA)</b> &mdash; Unggah bukti transfer di halaman invoice (Batas 15 Menit)
                                </MudRadio>
                                <MudRadio Value="@("BayarDiTempat")" Color="Color.Primary">
                                    <b>Bayar di Tempat (Cash / QRIS)</b> &mdash; Bayar langsung di kasir saat tiba (Toleransi 20 Menit)
                                </MudRadio>
                            </MudRadioGroup>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Elevation="2" Class="pa-4 mb-4">
                            <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="mr-1" />
                                Ringkasan Reservasi
                            </MudText>
                            <MudSimpleTable Dense="true" Hover="true" Class="mb-4">
                                <tbody>
                                    <tr>
                                        <td><b>Tanggal Kunjungan</b></td>
                                        <td>@(_selectedDate?.ToString("dddd, dd MMMM yyyy") ?? "-")</td>
                                    </tr>
                                    <tr>
                                        <td><b>Sesi Waktu</b></td>
                                        <td>@(_selectedTimeslot?.SessionName ?? "-")</td>
                                    </tr>
                                    <tr>
                                        <td><b>Durasi Duduk</b></td>
                                        <td>@_durationHours Jam</td>
                                    </tr>
                                    <tr>
                                        <td><b>Nomor Meja</b></td>
                                        <td>
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                                @(_selectedTable?.TableNumber ?? "-") (@(_selectedTable?.Area ?? "-"))
                                            </MudChip>
                                        </td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>

                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                                Rincian Pre-Order F&B (@CartItems.Sum(c => c.Quantity) Item)
                            </MudText>
                            @if (CartItems.Any())
                            {
                                <MudSimpleTable Dense="true" Class="mb-4">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th class="text-center">Porsi</th>
                                            <th class="text-right">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in CartItems)
                                        {
                                            <tr>
                                                <td>@c.Name</td>
                                                <td class="text-center">@c.Quantity</td>
                                                <td class="text-right">@c.SubTotal.ToRupiah()</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                                    Tidak ada pre-order menu F&B. Anda tetap bisa memesan di kasir saat tiba.
                                </MudAlert>
                            }

                            <MudDivider Class="my-2" />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="py-2">
                                <MudText Typo="Typo.h6" Class="font-weight-bold">Total Pembayaran</MudText>
                                <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
                                    @CartTotal.ToRupiah()
                                </MudText>
                            </MudStack>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-space-between mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => GoToStep(3))">
                            Kembali ke Menu
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   Disabled="@_isSubmitting"
                                   EndIcon="@Icons.Material.Filled.Check"
                                   OnClick="SubmitBookingAsync">
                            @if (_isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Memproses Invoice...</span>
                            }
                            else
                            {
                                <span>Buat Pesanan & Terbitkan Invoice</span>
                            }
                        </MudButton>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        @* ── STICKY BOTTOM SUMMARY BAR ── *@
        @if (_selectedTable != null && _activeStep < 4)
        {
            <MudPaper Elevation="8" Class="pa-4 d-flex flex-wrap justify-space-between align-center"
                      Style="position: sticky; bottom: 16px; z-index: 100; border-radius: 12px; background-color: var(--mud-palette-surface);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="flex-wrap">
                    <MudChip T="string" Color="Color.Primary" Icon="@Icons.Material.Filled.TableRestaurant">
                        Meja: @_selectedTable.TableNumber (@_selectedTable.Area)
                    </MudChip>
                    <MudText Typo="Typo.body2" Class="d-none d-sm-block">
                        Durasi: <b>@_durationHours Jam</b> | Pre-Order: <b>@CartItems.Sum(c => c.Quantity) Item</b>
                    </MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">
                        @CartTotal.ToRupiah()
                    </MudText>
                </MudStack>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="@(() => GoToStep(_activeStep + 1))">
                    Lanjut
                </MudButton>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private int _activeStep = 1;

    private DateTime? _selectedDate = DateTime.Today;
    private int _selectedTimeslotId = 1;
    private int _durationHours = 2;
    private string _selectedCategory = "Semua";

    private DiningTableDto? _selectedTable;
    private string _representativeName = string.Empty;
    private string _customerPhone = string.Empty;
    private string _paymentMethod = "TransferBank";

    private List<TimeslotDto> _timeslots = new();
    private List<DiningTableDto> _tables = new();
    private List<MenuItemDto> _menuItems = new();
    private Dictionary<Guid, OrderItemDto> _cart = new();

    private TimeslotDto? _selectedTimeslot => _timeslots.FirstOrDefault(t => t.Id == _selectedTimeslotId);

    private IEnumerable<MenuItemDto> FilteredMenuItems =>
        _selectedCategory == "Semua"
            ? _menuItems
            : _menuItems.Where(m => m.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));

    private List<OrderItemDto> CartItems => _cart.Values.ToList();
    private decimal CartTotal => _cart.Values.Sum(c => c.SubTotal);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _representativeName = user.Identity.Name ?? string.Empty;
                var phoneClaim = user.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value;
                if (!string.IsNullOrEmpty(phoneClaim))
                {
                    _customerPhone = phoneClaim;
                }
            }

            _timeslots = await BookingService.GetTimeslotsAsync();
            if (_timeslots.Any())
            {
                _selectedTimeslotId = _timeslots.First().Id;
            }

            _menuItems = await BookingService.GetAvailableMenuItemsAsync();
            await RefreshTablesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnTimeslotChanged(int newTimeslotId)
    {
        _selectedTimeslotId = newTimeslotId;
        _selectedTable = null;
        await RefreshTablesAsync();
    }

    private void OnDurationChanged(int newDuration)
    {
        _durationHours = newDuration;
    }

    private void OnCategoryFilterChanged(string category)
    {
        _selectedCategory = category;
    }

    private async Task RefreshTablesAsync()
    {
        if (_selectedDate == null) return;
        var date = DateOnly.FromDateTime(_selectedDate.Value);
        _tables = await BookingService.GetAvailableTablesAsync(date, _selectedTimeslotId);
    }

    private void SelectTable(DiningTableDto table)
    {
        if (!table.IsAvailable)
        {
            Snackbar.Add($"Meja {table.TableNumber} sudah terisi untuk sesi ini.", Severity.Warning);
            return;
        }

        _selectedTable = table;
        StateHasChanged();
    }

    private void AddToCart(MenuItemDto item)
    {
        if (_cart.TryGetValue(item.Id, out var orderItem))
        {
            orderItem.Quantity++;
        }
        else
        {
            _cart[item.Id] = new OrderItemDto
            {
                MenuItemId = item.Id,
                Name = item.Name,
                Quantity = 1,
                UnitPrice = item.Price
            };
        }
    }

    private void DecreaseCart(Guid menuItemId)
    {
        if (_cart.TryGetValue(menuItemId, out var orderItem))
        {
            orderItem.Quantity--;
            if (orderItem.Quantity <= 0)
            {
                _cart.Remove(menuItemId);
            }
        }
    }

    private int GetCartQuantity(Guid menuItemId)
    {
        return _cart.TryGetValue(menuItemId, out var item) ? item.Quantity : 0;
    }

    private async Task GoToStep(int step)
    {
        if (step == 2)
        {
            await RefreshTablesAsync();
        }
        else if (step >= 3 && _selectedTable == null)
        {
            Snackbar.Add("Harap pilih meja terlebih dahulu.", Severity.Warning);
            return;
        }
        else if (step == 4 && (string.IsNullOrWhiteSpace(_representativeName) || string.IsNullOrWhiteSpace(_customerPhone)))
        {
            // Allowed to step, fields will be validated on submit
        }

        _activeStep = step;
    }

    private string GetTableCardClass(DiningTableDto table, bool isSelected)
    {
        if (isSelected) return "mud-theme-warning-hover pa-2";
        if (!table.IsAvailable) return "mud-theme-dark-hover pa-2 opacity-50";
        return "mud-theme-primary-hover pa-2";
    }

    private Color GetTableIconColor(DiningTableDto table, bool isSelected)
    {
        if (isSelected) return Color.Warning;
        if (!table.IsAvailable) return Color.Dark;
        return Color.Success;
    }

    private async Task SubmitBookingAsync()
    {
        if (_selectedTable == null)
        {
            Snackbar.Add("Pilih meja terlebih dahulu.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_representativeName))
        {
            Snackbar.Add("Nama perwakilan rombongan wajib diisi.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_customerPhone))
        {
            Snackbar.Add("Nomor WhatsApp wajib diisi untuk konfirmasi.", Severity.Warning);
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out var userId))
        {
            Snackbar.Add("Sesi login Anda tidak valid. Silakan login ulang.", Severity.Error);
            NavigationManager.NavigateTo("/Account/Login?returnUrl=/Booking");
            return;
        }

        _isSubmitting = true;
        try
        {
            var request = new CreateBookingRequestDto
            {
                TableId = _selectedTable.Id,
                BookingDate = DateOnly.FromDateTime(_selectedDate ?? DateTime.Today),
                TimeslotId = _selectedTimeslotId,
                DurationHours = _durationHours,
                RepresentativeName = _representativeName,
                CustomerPhone = _customerPhone,
                PaymentMethod = _paymentMethod,
                SelectedItems = CartItems
            };

            var bookingId = await BookingService.CreateBookingAsync(request, userId);
            Snackbar.Add("Reservasi berhasil dibuat! Silakan selesaikan invoice.", Severity.Success);
            NavigationManager.NavigateTo($"/Invoice/{bookingId}");
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await RefreshTablesAsync();
            _activeStep = 2; // Return to table selection
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
