@page "/Account/Register"
@using System.Web
@using KopiKala.DTOs.Auth
@using KopiKala.Services
@inject NavigationManager Navigation

<PageTitle>Daftar Akun — KopiKala</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center py-8" Style="min-height: 90vh;">
    <MudPaper Elevation="3" Class="pa-8 w-100" Style="border-radius: 20px; max-width: 480px;">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Coffee" Size="Size.Large" Color="Color.Primary" Style="font-size: 52px;" />
            <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold" Color="Color.Primary">
                KopiKala
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Buat akun baru untuk mulai pesan meja
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                <MudText Typo="Typo.body2">@_errorMessage</MudText>
            </MudAlert>
        }

        <form method="post" action="/auth/register-submit">
            <div class="mb-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-medium">Nama Lengkap</MudText>
                <div class="mud-input-control mud-input-input-control">
                    <div class="mud-input mud-input-outlined">
                        <input type="text"
                               name="fullName"
                               required
                               placeholder="Nama lengkap Anda"
                               class="mud-input-slot mud-input-root mud-input-root-outlined pa-3"
                               style="width: 100%; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; font-size: 14px; background: transparent; color: inherit;" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-medium">Alamat Email</MudText>
                <div class="mud-input-control mud-input-input-control">
                    <div class="mud-input mud-input-outlined">
                        <input type="email"
                               name="email"
                               required
                               placeholder="contoh@email.com"
                               class="mud-input-slot mud-input-root mud-input-root-outlined pa-3"
                               style="width: 100%; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; font-size: 14px; background: transparent; color: inherit;" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-medium">Nomor Telepon / WhatsApp</MudText>
                <div class="mud-input-control mud-input-input-control">
                    <div class="mud-input mud-input-outlined">
                        <input type="tel"
                               name="phoneNumber"
                               required
                               placeholder="081234567890"
                               class="mud-input-slot mud-input-root mud-input-root-outlined pa-3"
                               style="width: 100%; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; font-size: 14px; background: transparent; color: inherit;" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-medium">Kata Sandi</MudText>
                <div class="mud-input-control mud-input-input-control">
                    <div class="mud-input mud-input-outlined">
                        <input type="password"
                               name="password"
                               required
                               minlength="6"
                               placeholder="Minimal 6 karakter"
                               class="mud-input-slot mud-input-root mud-input-root-outlined pa-3"
                               style="width: 100%; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; font-size: 14px; background: transparent; color: inherit;" />
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-medium">Konfirmasi Kata Sandi</MudText>
                <div class="mud-input-control mud-input-input-control">
                    <div class="mud-input mud-input-outlined">
                        <input type="password"
                               name="confirmPassword"
                               required
                               minlength="6"
                               placeholder="Ulangi kata sandi"
                               class="mud-input-slot mud-input-root mud-input-root-outlined pa-3"
                               style="width: 100%; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; font-size: 14px; background: transparent; color: inherit;" />
                    </div>
                </div>
            </div>

            <button type="submit"
                    class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-size-large mud-width-full mb-4"
                    style="height: 48px; font-size: 16px; font-weight: 600; border-radius: 8px; width: 100%; cursor: pointer;">
                <span class="mud-button-label">Daftar Sekarang</span>
            </button>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-3">atau</MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Large"
                       FullWidth="true"
                       Class="mb-4"
                       Style="height: 48px; font-size: 15px;"
                       Href="/auth/google">
                <MudImage Src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                          Alt="Google"
                          Height="20"
                          Width="20"
                          Class="me-2" />
                Daftar dengan Google
            </MudButton>
        </form>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-3" Color="Color.Secondary">
            Sudah punya akun?
            <MudLink Href="/Account/Login" Color="Color.Primary" Class="font-weight-bold">Masuk di sini</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        _errorMessage = query["error"];
    }
}
