@page "/Account/ResetPassword"
@using System.ComponentModel.DataAnnotations
@using System.Web
@using KopiKala.Services
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>Reset Kata Sandi — KopiKala</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-8" Style="min-height: 90vh;">
    <MudPaper Elevation="3" Class="pa-8 w-100" Style="border-radius: 20px;">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Large" Color="Color.Primary" Style="font-size: 52px;" />
            <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold" Color="Color.Primary">
                Atur Kata Sandi Baru
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Masukkan kata sandi baru untuk akun Anda
            </MudText>
        </div>

        @if (_isSuccess)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                <MudText Typo="Typo.body2">
                    Kata sandi Anda berhasil diperbarui! Silakan masuk dengan kata sandi baru.
                </MudText>
            </MudAlert>

            <MudButton Href="/Account/Login"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-2"
                       Style="height: 48px; font-weight: 600;">
                Masuk Sekarang
            </MudButton>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                    <MudText Typo="Typo.body2">@_errorMessage</MudText>
                </MudAlert>
            }

            <EditForm Model="@_model" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.Email"
                              Label="Alamat Email"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Class="mb-3"
                              For="@(() => _model.Email)"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />

                <MudTextField @bind-Value="_model.NewPassword"
                              Label="Kata Sandi Baru"
                              InputType="InputType.Password"
                              Placeholder="Minimal 6 karakter"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              For="@(() => _model.NewPassword)"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock" />

                <MudTextField @bind-Value="_model.ConfirmNewPassword"
                              Label="Konfirmasi Kata Sandi Baru"
                              InputType="InputType.Password"
                              Placeholder="Ulangi kata sandi baru"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              For="@(() => _model.ConfirmNewPassword)"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LockClock" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           Disabled="_isLoading"
                           Class="mb-3"
                           Style="height: 48px; font-size: 16px; font-weight: 600;">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ms-2" Color="Color.Inherit" />
                    }
                    else
                    {
                        @:Simpan Kata Sandi Baru
                    }
                </MudButton>

                <div class="text-center mt-3">
                    <MudLink Href="/Account/Login" Color="Color.Primary" Typo="Typo.body2">
                        &larr; Batal dan kembali ke Login
                    </MudLink>
                </div>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private ResetPasswordModel _model = new();
    private string? _token;
    private string? _errorMessage;
    private bool _isLoading;
    private bool _isSuccess;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        _model.Email = query["email"] ?? "";
        _token = query["token"];

        if (string.IsNullOrEmpty(_token))
        {
            _errorMessage = "Token reset kata sandi tidak valid atau hilang.";
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrEmpty(_token))
        {
            _errorMessage = "Token reset kata sandi tidak valid.";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var success = await AuthService.ResetPasswordAsync(_model.Email, _token, _model.NewPassword);
            if (!success)
            {
                _errorMessage = "Gagal mereset kata sandi. Token mungkin sudah kedaluwarsa (maks. 15 menit) atau tidak cocok.";
                return;
            }

            _isSuccess = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "Email wajib diisi.")]
        [EmailAddress(ErrorMessage = "Format email tidak valid.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Kata sandi baru wajib diisi.")]
        [MinLength(6, ErrorMessage = "Kata sandi minimal 6 karakter.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Konfirmasi kata sandi wajib diisi.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Konfirmasi kata sandi tidak cocok.")]
        public string ConfirmNewPassword { get; set; } = "";
    }
}
