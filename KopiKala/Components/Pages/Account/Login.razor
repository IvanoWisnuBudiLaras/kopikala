@page "/Account/Login"
@using System.Web
@using KopiKala.DTOs.Auth
@using KopiKala.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Masuk — KopiKala</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-8" Style="min-height: 90vh;">
    <MudPaper Elevation="3" Class="pa-8 w-100" Style="border-radius: 20px;">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Coffee" Size="Size.Large" Color="Color.Primary" Style="font-size: 56px;" />
            <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold" Color="Color.Primary">
                KopiKala
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Masuk ke akun Anda
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                <MudText Typo="Typo.body2">@_errorMessage</MudText>
            </MudAlert>
        }

        <EditForm Model="@_loginDto" OnValidSubmit="HandleLoginSubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_loginDto.Email"
                          Label="Alamat Email"
                          Placeholder="contoh@email.com"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          For="@(() => _loginDto.Email)"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email" />

            <MudTextField @bind-Value="_loginDto.Password"
                          Label="Kata Sandi"
                          InputType="InputType.Password"
                          Placeholder="Masukkan kata sandi"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          For="@(() => _loginDto.Password)"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock" />

            <div class="d-flex justify-space-between align-center mb-4">
                <MudCheckBox @bind-Value="_loginDto.RememberMe"
                             Label="Ingat Saya"
                             Color="Color.Primary"
                             Dense="true" />
                <MudLink Href="/Account/ForgotPassword" Color="Color.Primary" Typo="Typo.body2">
                    Lupa kata sandi?
                </MudLink>
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="_isLoading"
                       Class="mb-4"
                       Style="height: 48px; font-size: 16px; font-weight: 600;">
                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ms-2" Color="Color.Inherit" />
                }
                else
                {
                    @:Masuk
                }
            </MudButton>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-4">atau</MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Large"
                       FullWidth="true"
                       Class="mb-4"
                       Style="height: 48px; font-size: 15px;"
                       Href="/auth/google">
                <MudImage Src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                         Alt="Google"
                         Height="20"
                         Width="20"
                         Class="me-2" />
                Masuk dengan Google
            </MudButton>
        </EditForm>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4" Color="Color.Secondary">
            Belum punya akun?
            <MudLink Href="/Account/Register" Color="Color.Primary" Class="font-weight-bold">Daftar sekarang</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private LoginRequestDto _loginDto = new();
    private string? _errorMessage;
    private bool _isLoading;
    private string? _returnUrl;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        _errorMessage = query["error"];
        _returnUrl = query["returnUrl"];
    }

    private async Task HandleLoginSubmitAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(_loginDto);
            if (!result.Success || result.Principal == null)
            {
                _errorMessage = result.ErrorMessage ?? "Login gagal.";
                return;
            }

            // SignIn langsung di komponen Blazor
            var authProperties = new AuthenticationProperties
            {
                IsPersistent = _loginDto.RememberMe,
                ExpiresUtc = _loginDto.RememberMe ? DateTimeOffset.UtcNow.AddDays(30) : null
            };

            await HttpContextAccessor.HttpContext!.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme, result.Principal, authProperties);

            // Redirect: prioritaskan returnUrl jika tersedia dan aman
            if (!string.IsNullOrWhiteSpace(_returnUrl) && IsLocalUrl(_returnUrl))
            {
                Navigation.NavigateTo(_returnUrl);
                return;
            }

            // Fallback: Redirect berdasarkan permission
            if (result.Principal.HasClaim("Permission", "Sistem.Kelola"))
            {
                Navigation.NavigateTo("/SuperAdmin");
            }
            else if (result.Principal.HasClaim(c => c.Type == "Permission" && new[] { "Meja.Kelola", "Pembayaran.Verifikasi", "Dapur.Antrean", "Laporan.Lihat" }.Contains(c.Value)))
            {
                Navigation.NavigateTo("/Staff");
            }
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static bool IsLocalUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        if (url.StartsWith("//") || url.StartsWith("/#")) return false;

        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return uri.Authority.Equals("localhost", StringComparison.OrdinalIgnoreCase)
                || uri.Authority.Equals("127.0.0.1", StringComparison.OrdinalIgnoreCase);

        return url.StartsWith("/");
    }
}
