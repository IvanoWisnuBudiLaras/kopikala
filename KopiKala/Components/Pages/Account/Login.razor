@page "/Account/Login"
@using System.Web
@using KopiKala.DTOs.Auth
@using KopiKala.Services
@inject NavigationManager Navigation

<PageTitle>Masuk — KopiKala</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-8" Style="min-height: 90vh;">
    <MudPaper Elevation="3" Class="pa-8 w-100" Style="border-radius: 20px;">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Coffee" Size="Size.Large" Color="Color.Primary" Style="font-size: 56px;" />
            <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold" Color="Color.Primary">
                KopiKala
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Masuk ke akun Anda
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                <MudText Typo="Typo.body2">@_errorMessage</MudText>
            </MudAlert>
        }

        <form method="post" action="/auth/login-submit">
            <input type="hidden" name="returnUrl" value="@_returnUrl" />

            <div class="mb-4">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-medium">Alamat Email</MudText>
                <div class="mud-input-control mud-input-input-control">
                    <div class="mud-input mud-input-outlined mud-input-adorned-start">
                        <div class="mud-input-adornment mud-input-adornment-start">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Default" />
                        </div>
                        <input type="email"
                               name="email"
                               required
                               placeholder="contoh@email.com"
                               class="mud-input-slot mud-input-root mud-input-root-outlined mud-input-root-adorned-start pa-3"
                               style="width: 100%; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; font-size: 14px; background: transparent; color: inherit;" />
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 font-weight-medium">Kata Sandi</MudText>
                <div class="mud-input-control mud-input-input-control">
                    <div class="mud-input mud-input-outlined mud-input-adorned-start">
                        <div class="mud-input-adornment mud-input-adornment-start">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" />
                        </div>
                        <input type="password"
                               name="password"
                               required
                               placeholder="Masukkan kata sandi"
                               class="mud-input-slot mud-input-root mud-input-root-outlined mud-input-root-adorned-start pa-3"
                               style="width: 100%; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; font-size: 14px; background: transparent; color: inherit;" />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-space-between align-center mb-4">
                <label class="d-flex align-center cursor-pointer" style="font-size: 14px; color: var(--mud-palette-text-secondary);">
                    <input type="checkbox" name="rememberMe" value="true" class="mr-2" style="accent-color: var(--mud-palette-primary);" />
                    Ingat Saya
                </label>
                <MudLink Href="/Account/ForgotPassword" Color="Color.Primary" Typo="Typo.body2">
                    Lupa kata sandi?
                </MudLink>
            </div>

            <button type="submit"
                    class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-size-large mud-width-full mb-4"
                    style="height: 48px; font-size: 16px; font-weight: 600; border-radius: 8px; width: 100%; cursor: pointer;">
                <span class="mud-button-label">Masuk</span>
            </button>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-4">atau</MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Large"
                       FullWidth="true"
                       Class="mb-4"
                       Style="height: 48px; font-size: 15px;"
                       Href="/auth/google">
                <MudImage Src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                          Alt="Google"
                          Height="20"
                          Width="20"
                          Class="me-2" />
                Masuk dengan Google
            </MudButton>
        </form>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4" Color="Color.Secondary">
            Belum punya akun?
            <MudLink Href="/Account/Register" Color="Color.Primary" Class="font-weight-bold">Daftar sekarang</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private string? _errorMessage;
    private string? _returnUrl;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        _errorMessage = query["error"];
        _returnUrl = query["returnUrl"];
    }
}
