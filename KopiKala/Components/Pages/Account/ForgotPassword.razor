@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@using KopiKala.Services
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>Lupa Kata Sandi — KopiKala</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center py-8" Style="min-height: 90vh;">
    <MudCard Class="pa-8" Style="border-radius: 20px; box-shadow: 0 12px 40px rgba(0,0,0,0.08); width: 100%;">
        <MudCardContent>
            <div class="text-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Color="Color.Primary" Style="font-size: 52px;" />
                <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold" Color="Color.Primary">
                    Lupa Kata Sandi?
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">
                    Masukkan email Anda untuk menerima link reset kata sandi
                </MudText>
            </div>

            @if (_isSubmitted)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    <MudText Typo="Typo.body2">
                        Jika email terdaftar di sistem kami, instruksi reset kata sandi telah dikirimkan.
                    </MudText>
                </MudAlert>

                @if (!string.IsNullOrEmpty(_simulatedResetLink))
                {
                    <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background: #F2EFE9; border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                            Simulasi Link Reset (Lingkungan Dev):
                        </MudText>
                        <MudLink Href="@_simulatedResetLink" Typo="Typo.body2" Color="Color.Primary" Style="word-break: break-all;">
                            Klik di sini untuk reset kata sandi &rarr;
                        </MudLink>
                    </MudPaper>
                }

                <MudButton Href="/Account/Login"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-2"
                           Style="height: 44px; font-weight: 600;">
                    Kembali ke Halaman Masuk
                </MudButton>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                        <MudText Typo="Typo.body2">@_errorMessage</MudText>
                    </MudAlert>
                }

                <EditForm Model="@_model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <MudTextField @bind-Value="_model.Email"
                                  Label="Alamat Email"
                                  Placeholder="contoh@email.com"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"
                                  For="@(() => _model.Email)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="_isLoading"
                               Class="mb-3"
                               Style="height: 48px; font-size: 16px; font-weight: 600;">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ms-2" Color="Color.Inherit" />
                        }
                        else
                        {
                            @:Kirim Link Reset
                        }
                    </MudButton>

                    <div class="text-center mt-3">
                        <MudLink Href="/Account/Login" Color="Color.Primary" Typo="Typo.body2">
                            &larr; Ingat kata sandi? Masuk
                        </MudLink>
                    </div>
                </EditForm>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private ForgotPasswordModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _isSubmitted;
    private string? _simulatedResetLink;

    private async Task HandleSubmitAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var token = await AuthService.GeneratePasswordResetTokenAsync(_model.Email);
            if (token != null)
            {
                _simulatedResetLink = $"/Account/ResetPassword?email={Uri.EscapeDataString(_model.Email)}&token={Uri.EscapeDataString(token)}";
            }
            // Selalu tampilkan pesan sukses (mencegah enumerasi akun)
            _isSubmitted = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email wajib diisi.")]
        [EmailAddress(ErrorMessage = "Format email tidak valid.")]
        public string Email { get; set; } = "";
    }
}
